# Supabase (Settings -> API в панели проекта)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role - только для сервера, никогда не светить на клиенте
SUPABASE_SERVICE_ROLE_KEY=

# Публичный URL приложения (для redirect после оплаты и т.п.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ЮKassa (кабинет ЮKassa -> Настройки -> API)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=
