# Supabase (service role - воркер работает от имени сервиса, обходит RLS)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (Upstash) - очередь BullMQ
REDIS_URL=

# Claude API
ANTHROPIC_API_KEY=

# Telegram Bot API - бот для подсказок менеджерам и сводок собственнику
TELEGRAM_BOT_TOKEN=

# Шифрование session-строк Telegram User API (openssl rand -hex 32)
SESSION_ENCRYPTION_KEY=

# Telegram API credentials для User API (my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
